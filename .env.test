# Test Environment Variables
# This file is used for E2E testing

# Test Database (localhost)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/hafiportrait_test?sslmode=disable

# NextAuth (use test secret)
NEXTAUTH_SECRET=test-secret-key-for-e2e-testing-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Public URL
NEXT_PUBLIC_URL=http://localhost:3000

# Disable external services in tests
RESEND_API_KEY=test_key
ABLY_API_KEY=test_key
CLOUDFLARE_API_TOKEN=test_token
VPS_WEBHOOK_SECRET=test_webhook_secret
