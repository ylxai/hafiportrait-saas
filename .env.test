# Test Environment Variables
# This file is used for E2E testing

# Test Database (use a separate database for testing)
TEST_DATABASE_URL=postgres://tsdbadmin:YOUR_PASSWORD@host.tsdb.cloud.timescale.com:33301/tsdb_test?sslmode=require

# NextAuth (use test secret)
NEXTAUTH_SECRET=test-secret-key-for-e2e-testing
NEXTAUTH_URL=http://localhost:3000

# Public URL
NEXT_PUBLIC_URL=http://localhost:3000

# Disable external services in tests
RESEND_API_KEY=test_key
ABLY_API_KEY=test_key
CLOUDFLARE_API_TOKEN=test_token
VPS_WEBHOOK_SECRET=test_webhook_secret
