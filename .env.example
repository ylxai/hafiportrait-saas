# Environment Variables
# Copy this file to .env and fill in your values

# Database (TimescaleDB / PostgreSQL)
#
# IMPORTANT (Sprint 2 Task 2.2): on Vercel serverless, append connection
# pool params to keep Postgres `max_connections` from being exhausted.
# Recommended for direct connections (not Prisma Accelerate):
#   ?sslmode=require&connection_limit=5&pool_timeout=10&connect_timeout=10
#
# - connection_limit=5  : cap concurrent connections per function instance
# - pool_timeout=10     : seconds to wait for a free connection before erroring
# - connect_timeout=10  : seconds to wait for the initial DB handshake
#
# If you switch to Prisma Accelerate (URL starts with `prisma://`), the
# pooler handles connection management server-side and these params can
# be omitted. Note: `src/lib/db.ts` does NOT yet enable
# `withAccelerate()` — wrapping the client surfaces TS regressions in
# existing transaction callbacks and is tracked as a deferred
# follow-up. Until that lands, switching DATABASE_URL to `prisma://`
# alone is not enough; the client needs the extension too.
DATABASE_URL=postgres://tsdbadmin:***@host.tsdb.cloud.timescale.com:33301/tsdb?sslmode=require&connection_limit=5&pool_timeout=10&connect_timeout=10

# NextAuth
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Resend (Magic Link Email)
RESEND_API_KEY=re_your_api_key_here

# Public URL (for magic link generation)
NEXT_PUBLIC_URL=http://localhost:3000

# Cloudflare
CLOUDFLARE_API_TOKEN=your_cloudflare_token_here
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_WORKER_URL=https://your-worker.workers.dev
NEXT_SERVER_CF_QUEUE_TOKEN=your_queue_token

# Ably (Real-time)
ABLY_API_KEY=your_ably_key_here
NEXT_PUBLIC_ABLY_CHANNEL_PREFIX=photostudio

# Webhook Secret (HMAC-SHA256)
VPS_WEBHOOK_SECRET=your_webhook_secret_here

# Cloudinary (optional, for thumbnails)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Redis / Valkey (rate limiting + cache)
NEXT_SERVER_REDIS_URL=rediss://default:password@host:6379

# MCP API Keys
GITHUB_TOKEN=ghp_your_token_here
